{
  "name": "seq_show_case",
  "version": "0.1.0",
  "description": "Sequence Diagram Web Component - React + React Flow + Shadow DOM",
  "type": "module",
  "main": "dist/sequence-diagram.iife.js",
  "module": "dist/sequence-diagram.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sequence-diagram.es.js",
      "require": "./dist/sequence-diagram.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --project tsconfig.build.json && vite build && node scripts/copy-schema.mjs && node scripts/copy-examples.mjs",
    "build:typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --dir tests/visual",
    "test:watch": "vitest",
    "serve:dist": "python3 -m http.server 3000 --directory dist",
    "verify-dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
